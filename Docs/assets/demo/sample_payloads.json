          { "day": "Thu", "count": 41 },
          { "day": "Fri", "count": 42 },
          { "day": "Sat", "count": 0 },
          { "day": "Sun", "count": 0 }
        ],
        "scope": "Class-Specific",
        "defaults": {
          "start_time": "09:00",
          "off_time": "17:00"
        }
      }
    }
  }
}
