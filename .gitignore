# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# --- Environment & Secret Keys (NEVER COMMIT) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Biometric & PII Uploads (Keep folder structure with .gitkeep)
backend/media/face_data/*
!backend/media/face_data/.gitkeep
backend/media/student_profiles/*
!backend/media/student_profiles/.gitkeep
backend/media/teacher_profiles/*
!backend/media/teacher_profiles/.gitkeep

# Python Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- Node.js & Frontend ---
frontend/node_modules/
node_modules/
frontend/build/
build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Operating System & Editor Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
