# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to '.env' and update the values with your local/production credentials.
# ==============================================================================

# Django Secret Key (Generate a secure secret key for production)
SECRET_KEY=django-insecure-generate-a-secure-random-key-here

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list of host/domain names)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL)
DB_NAME=face_recognition
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Cryptography / Fernet Symmetric Encryption Key
# Used for encrypting sensitive student PII (phone number, address) and biometric files at rest.
# Generate via Python:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_base64_encryption_key_here

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
